# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
env/
.env
.ipynb_checkpoints/

# setuptools build residue (`uv build` / `python -m build`)
build/
dist/

# test / coverage artefacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
test-results/
tests/e2e/__snapshots__/*-actual.png

# Hydra writes an `outputs/` run dir next to whatever invokes it
outputs/

# Models / data / large artefacts
*.ckpt
*.pt
*.pth
*.onnx
*.npz
*.h5
*.hdf5

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# uv (project is conda/pip managed)
uv.lock

# ship two small illustrative example spectra (rest of the data is on Zenodo)
!examples/*.npz

# local-only working files — must never ship in the public release
CLAUDE.md
docs/requirements/
docs/ZENODO_DEPOSIT.md
deploy/EXTERNAL_STEPS.md

